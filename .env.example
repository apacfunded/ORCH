# ─────────────────────────────────────────────────────────────────────────────
# Receipts ($RECEIPTS) — environment
# Copy to .env.local (dev) or set in your host. Every variable is optional for
# local dev: with nothing set, the app runs on a simulated CT world + embedded DB.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
# Postgres connection string (Supabase, Neon, Railway, RDS…). Required in production.
# On Vercel, adding Neon from the Storage tab sets POSTGRES_URL / DATABASE_URL for you.
# When empty, an embedded PGlite database is used at PGLITE_DIR and the worker
# runs inside `npm run dev` (PGlite can only be opened by one process).
DATABASE_URL=
PGLITE_DIR=./.data/pglite
# Run the worker inside the Next.js server. Defaults to 1 without DATABASE_URL, 0 with it.
# On a single always-on server (Railway/Render/VPS) you can set 1 and skip `npm run worker`.
RUN_WORKER_INLINE=

# ── Data sources ─────────────────────────────────────────────────────────────
# "mock" = simulated accounts/coins (default when no X token). "x" = official X API v2.
DATA_SOURCE=
# X API v2 app-only bearer token (developer.x.com). Setting it switches DATA_SOURCE to "x".
X_BEARER_TOKEN=
# "mock" or "dexscreener" (free, no key). Defaults to dexscreener with real X data.
PRICE_SOURCE=

# ── AI extraction (optional) ─────────────────────────────────────────────────
# Without a key, rule-based extraction is used (contract addresses always come from
# regex either way, so the AI can never invent one).
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5

# ── Token gate ───────────────────────────────────────────────────────────────
# $RECEIPTS mint address. Leave empty before launch: everyone gets the delayed feed.
RECEIPTS_MINT=
# Whole tokens needed for live access / whale tier.
MIN_HOLD=1
WHALE_HOLD=10000000
# Solana RPC for balance checks. The public endpoint is rate limited — use Helius,
# Triton, QuickNode etc. in production (e.g. https://mainnet.helius-rpc.com/?api-key=…).
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# How often a signed-in wallet's balance is re-read from chain (seconds).
BALANCE_RECHECK_SECONDS=300
# How far behind live the public feed runs (minutes).
PUBLIC_DELAY_MINUTES=15

# ── Serverless worker (Vercel) ───────────────────────────────────────────────
# Protects /api/cron/worker, which runs one worker tick. Called every 5 minutes by
# .github/workflows/worker.yml (repo secrets SITE_URL + CRON_SECRET) or by Vercel Cron.
# Generate: openssl rand -hex 32
CRON_SECRET=

# ── Auth & admin ─────────────────────────────────────────────────────────────
# Long random string. REQUIRED in production. Generate: openssl rand -base64 48
SESSION_SECRET=
# Comma-separated wallet addresses that can open /admin (they also always see live).
ADMIN_WALLETS=

# ── Site ─────────────────────────────────────────────────────────────────────
# Public URL, used for share links and link previews.
SITE_URL=http://localhost:3000
# pump.fun page for $RECEIPTS (shows "Buy on pump.fun" in the footer when set).
PUMP_URL=
X_HANDLE=receipts
PARTNER_HANDLE=OTCDOTCASH

# ── Worker tuning ────────────────────────────────────────────────────────────
WORKER_TICK_SECONDS=30
# Default minutes between timeline checks for new accounts (per-account in /admin).
POLL_MINUTES=5
PROFILE_EVERY_MINUTES=60
# How long tweets are re-checked for deletions/edits, and how often.
RECHECK_HOURS=48
RECHECK_EVERY_MINUTES=10
LOG_LEVEL=info

# ── Detection thresholds (defaults; admins can override in /admin) ───────────
COORD_MIN_ACCOUNTS=5
COORD_WINDOW_MINUTES=30
FOLLOWER_SPIKE_PCT=20
DELETE_CONFIRM_FAILS=2
DELETE_CONFIRM_GAP_MINUTES=5
