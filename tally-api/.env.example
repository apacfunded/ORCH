# Upstash Redis (free tier works). On Vercel you can add the Upstash integration and it fills these in.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Long random string. Signs login sessions. Generate one with: openssl rand -hex 32
SESSION_SECRET=

# Long random string. Protects /api/cron. Use the same value in your cron pinger.
CRON_SECRET=

# Leave empty for live DexScreener prices. Set to "mock" for local testing without internet.
PRICE_SOURCE=
